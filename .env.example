# Shared by BOTH servers. Copy to .env (or run `npm run setup`, which creates it for you).

# MariaDB from XAMPP (default XAMPP login is root with an empty password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=blog_platform

# Same secret on both servers: Auth signs tokens, Blog verifies them. At least 32 characters.
JWT_SECRET=

AUTH_PORT=4000
BLOG_PORT=5000

# Where the React dev server runs (allowed by CORS)
FRONTEND_ORIGIN=http://localhost:5173
