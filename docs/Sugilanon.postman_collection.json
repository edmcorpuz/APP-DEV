{
  "info": {
    "name": "Sugilanon — complete midterm API demo",
    "description": "Run in order. Creates local postman_* accounts. No JWT secret required. Registration accepts 409 on repeat runs. Uses real endpoints and checks expected denial statuses.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "auth",
      "value": "http://localhost:4000"
    },
    {
      "key": "blog",
      "value": "http://localhost:5000"
    },
    {
      "key": "password",
      "value": "PostmanDemo123!"
    }
  ],
  "item": [
    {
      "name": "Register reader",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{auth}}/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"postman_reader\",\n  \"password\": \"{{password}}\",\n  \"role\": \"reader\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 201 or 409\", () => pm.expect([201,409]).to.include(pm.response.code));",
              "if (pm.response.code >= 400) pm.test('Uniform error shape', () => pm.expect(Object.keys(pm.response.json())).to.eql(['error']));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login reader",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{auth}}/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"postman_reader\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 200\", () => pm.expect([200]).to.include(pm.response.code));",
              "if (pm.response.code >= 400) pm.test('Uniform error shape', () => pm.expect(Object.keys(pm.response.json())).to.eql(['error']));",
              "if (pm.response.code === 200) { const data = pm.response.json(); pm.collectionVariables.set('readerAccessToken', data.accessToken); pm.collectionVariables.set('readerRefreshToken', data.refreshToken); }"
            ]
          }
        }
      ]
    },
